# Generate with: openssl rand -hex 32 (keep stable across API replicas/restarts)
AUTH_SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

API_PUBLIC_URL=http://localhost:3002
