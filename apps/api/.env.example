DIRECT_DATABASE_URL=postgresql://comit_api:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=comit&sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
ADMIN_EMAILS=admin@g.skku.edu
PORT=3002
# Cloudtype / Docker: HOST=0.0.0.0
HOST=127.0.0.1
# Integration tests must use a disposable database.
